# Copy this file to .env.host on the server. Do not commit .env.host.
APP_ENV=production
TRADING_MODE=paper
AUTONOMY_LEVEL=2
AUTO_EXECUTION=true
LIVE_TRADING_ENABLED=false
ROBINHOOD_EQUITY_EXECUTION_ENABLED=false
ROBINHOOD_CRYPTO_EXECUTION_ENABLED=false
ROBINHOOD_LIVE_TRADING_ENABLED=false
DASHBOARD_USERNAME=operator
DASHBOARD_PASSWORD=replace-with-a-long-unique-password
SECRET_KEY=replace-with-a-long-random-secret
ETRADE_CONSUMER_KEY=
ETRADE_CONSUMER_SECRET=

# Read-only external-paper monitoring; no order capability.
ALPACA_MONITOR_SYMBOLS=AAPL,MSFT
ALPACA_MONITOR_INTERVAL_SECONDS=15
ALPACA_PAPER_EXECUTION_ENABLED=false
